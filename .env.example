# Database
DATABASE_URL="postgresql://user:password@localhost:5432/sidehustle"

# NextAuth — generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Seed credentials (used by: npx prisma db seed)
SEED_ADMIN_EMAIL="admin@sidehustle.art"
SEED_ADMIN_PASSWORD="changeme123!"

# Mailchimp (optional — newsletter signup)
MAILCHIMP_API_KEY=""
MAILCHIMP_AUDIENCE_ID=""
MAILCHIMP_API_SERVER="us1"

# Docker (optional — used by docker-compose.yml)
POSTGRES_PASSWORD="changeme"
